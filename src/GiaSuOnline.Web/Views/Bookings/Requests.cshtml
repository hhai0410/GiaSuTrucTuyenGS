@model List<Booking>
@{ViewData["Title"]="Yêu cầu học";}
<p class="eyebrow">GÓC GIA SƯ</p><h1>Yêu cầu học của học viên</h1><p>Chấp nhận hoặc từ chối trước 24 giờ kể từ khi gửi yêu cầu và trước giờ học. Khi từ chối, khung giờ được mở lại.</p>
@if(Model.Count==0){<div class="empty">Chưa có yêu cầu đặt lịch.</div>}
<div class="table-responsive"><table class="table"><thead><tr><th>Mã</th><th>Học viên</th><th>Buổi học</th><th>Học phí</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var booking in Model){<tr><td><a asp-action="Details" asp-route-id="@booking.Id">#@booking.Id</a></td><td>@booking.Student.FullName</td><td>@VietnamTime.Format(booking.StartsAtUtc)</td><td>@booking.Amount.ToString("N0") đ</td><td>@VietnamTime.Status(booking.Status)</td><td>@if(booking.Status==BookingStatus.Pending){<form asp-action="Decide" method="post"><input name="Id" value="@booking.Id" type="hidden"/><input name="Revision" value="@booking.Revision" type="hidden"/><div class="actions"><button name="Accept" value="true" class="btn btn-success">Chấp nhận</button><button name="Accept" value="false" class="btn btn-outline-danger">Từ chối</button></div></form>}</td></tr>}</tbody></table></div>