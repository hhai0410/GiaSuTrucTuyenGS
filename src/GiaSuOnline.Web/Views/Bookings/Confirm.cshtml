@model BookingConfirmation
@{ViewData["Title"]="Xác nhận đặt lịch";var slot=Model.Slot;}
<section class="form-panel"><p class="eyebrow">BUỔI HỌC CỦA BẠN</p><h1>Xác nhận đặt lịch</h1><h2>@slot.TutorProfile.User.FullName</h2><p>@VietnamTime.Format(slot.StartsAtUtc) → @VietnamTime.Format(slot.EndsAtUtc)</p><p>Học phí: @slot.TutorProfile.HourlyRate.ToString("N0") đ/giờ</p><p>Tổng học phí: <strong>@Model.Amount.ToString("N0") đ</strong></p><p>Gia sư cần chấp nhận yêu cầu. Yêu cầu chưa được phản hồi sẽ tự hết hạn sau 24 giờ hoặc khi đến giờ học.</p><form asp-action="Create" method="post"><input name="SlotId" value="@slot.Id" type="hidden"/><input name="SlotRevision" value="@slot.Revision" type="hidden"/><input name="ProfileRevision" value="@slot.TutorProfile.Revision" type="hidden"/><button type="submit" class="btn btn-primary">Gửi yêu cầu đặt lịch</button></form><a asp-controller="TutorProfiles" asp-action="Booking" asp-route-id="@slot.TutorProfileId">Chọn giờ khác</a></section>