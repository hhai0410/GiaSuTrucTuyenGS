@model ResetForm
@{ViewData["Title"]="Đặt lại mật khẩu";}
<section class="form-panel"><h1>Đặt lại mật khẩu</h1><form method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Email" type="hidden"/><input asp-for="Token" type="hidden"/><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="new-password" required minlength="8"/><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" required/><button class="btn btn-primary" type="submit">Lưu mật khẩu mới</button></form></section>