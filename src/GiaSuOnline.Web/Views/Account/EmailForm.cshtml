@model ForgotForm
@{var resend=ViewContext.RouteData.Values["action"]?.ToString()=="ResendConfirmation";ViewData["Title"]=resend?"Gửi lại xác nhận":"Quên mật khẩu";}
<section class="form-panel"><h1>@ViewData["Title"]</h1><p>Nhập email đã dùng để đăng ký GS.</p><form method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email" required/><button class="btn btn-primary" type="submit">Gửi hướng dẫn</button></form></section>