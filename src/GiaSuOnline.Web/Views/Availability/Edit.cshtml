@model SlotForm
@{ViewData["Title"]=Model.Id.HasValue?"Sửa lịch rảnh":"Thêm lịch rảnh";}
<section class="form-panel"><h1>@ViewData["Title"]</h1><p>Nhập giờ Việt Nam (UTC+7). Khung giờ cần ở tương lai và không chồng lấn.</p><form method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="Revision"/><label asp-for="StartsAt"></label><input asp-for="StartsAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" required/><label asp-for="EndsAt"></label><input asp-for="EndsAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" required/><button class="btn btn-primary" type="submit">Lưu khung giờ</button></form><a asp-action="Index">Quay lại lịch tuần</a></section>