@model WeekSchedule
@{ViewData["Title"]="Lịch rảnh";}
<p class="eyebrow">THỜI GIAN CỦA BẠN</p><h1>Lịch rảnh của tôi</h1><p>Giờ hiển thị theo Việt Nam (UTC+7). Khung giờ đã đặt được đánh dấu và không thể sửa/xóa.</p>
@if(Model.Profile==null||Model.Profile.Status!=ProfileStatus.Approved){<div class="alert alert-info">Hồ sơ cần được duyệt trước khi thêm hoặc sửa lịch rảnh.</div><a asp-controller="TutorProfiles" asp-action="Mine">Xem hồ sơ của tôi</a>}
else{<a class="btn btn-primary" asp-action="Edit">Thêm khung giờ</a>}
<div class="detail-panel calendar-panel"><div id="availability-calendar" data-events="@Url.Action("Events")" data-week="@Model.Monday.ToString("yyyy-MM-dd")"></div><p id="calendar-error" role="alert" hidden>Chưa tải được lịch. Bạn vẫn có thể dùng danh sách bên dưới hoặc tải lại trang.</p></div>
<details open><summary>Danh sách tuần @Model.Monday.ToString("dd/MM/yyyy")</summary><nav class="actions"><a asp-action="Index" asp-route-week="@Model.Monday.AddDays(-7).ToString("yyyy-MM-dd")">Tuần trước</a><a asp-action="Index">Tuần này</a><a asp-action="Index" asp-route-week="@Model.Monday.AddDays(7).ToString("yyyy-MM-dd")">Tuần sau</a></nav>
@if(Model.Slots.Count==0){<p>Tuần này chưa có khung giờ.</p>}
<div class="table-responsive"><table class="table"><thead><tr><th>Bắt đầu</th><th>Kết thúc</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var slot in Model.Slots){<tr><td>@VietnamTime.Format(slot.StartsAtUtc)</td><td>@VietnamTime.Format(slot.EndsAtUtc)</td><td><span class="badge @(slot.IsBooked?"text-bg-warning":"text-bg-success")">@(slot.IsBooked?"Đã đặt":"Còn trống")</span></td><td>@if(!slot.IsBooked){<a asp-action="Edit" asp-route-id="@slot.Id">Sửa</a><form method="post" asp-action="Delete"><input type="hidden" name="id" value="@slot.Id"/><input type="hidden" name="revision" value="@slot.Revision"/><button class="btn btn-outline-danger" type="submit">Xóa</button></form>}</td></tr>}</tbody></table></div></details>
@section Scripts{<script src="~/lib/fullcalendar/index.global.min.js" nonce="@Context.Items["CspNonce"]"></script><script src="~/lib/fullcalendar/vi.global.min.js" nonce="@Context.Items["CspNonce"]"></script><script src="~/js/calendar.js" asp-append-version="true" nonce="@Context.Items["CspNonce"]" defer></script>}