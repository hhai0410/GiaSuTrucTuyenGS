@model TutorDetail
@{ViewData["Title"]="Chọn khung giờ";var week=Model.Week ?? DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));}
<section class="detail-panel"><p class="eyebrow">CHỌN BUỔI HỌC</p><h1>Học cùng @Model.Profile.User.FullName</h1><p>Các khung giờ còn trống theo tuần (UTC+7). Học phí: @Model.Profile.HourlyRate.ToString("N0") đ/giờ.</p>
<nav class="actions"><a asp-action="Booking" asp-route-id="@Model.Profile.Id" asp-route-week="@week.AddDays(-7).ToString("yyyy-MM-dd")">Tuần trước</a><strong>Tuần @week.ToString("dd/MM/yyyy")</strong><a asp-action="Booking" asp-route-id="@Model.Profile.Id" asp-route-week="@week.AddDays(7).ToString("yyyy-MM-dd")">Tuần sau</a></nav>
@if(Model.Slots.Count==0){<div class="empty">Gia sư chưa có khung giờ trống trong tuần này. Bạn có thể quay lại sau hoặc tìm gia sư khác.</div>}
<ul class="slot-list">@foreach(var slot in Model.Slots){<li><span>@VietnamTime.Format(slot.StartsAtUtc) → @VietnamTime.Local(slot.EndsAtUtc).ToString("dd/MM HH:mm")</span><a class="btn btn-primary" asp-controller="Bookings" asp-action="Confirm" asp-route-slotId="@slot.Id">Chọn khung giờ</a></li>}</ul><a asp-action="Details" asp-route-id="@Model.Profile.Id">Quay lại hồ sơ</a></section>