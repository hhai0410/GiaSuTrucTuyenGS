@model TutorProfile?
@{ViewData["Title"]="Hồ sơ của tôi";}
<section><p class="eyebrow">GÓC GIA SƯ</p><h1>Hồ sơ của tôi</h1>
@if(Model==null){<div class="empty"><h2>Hãy giới thiệu chuyên môn của bạn</h2><p>Hoàn thiện hồ sơ để quản trị viên kiểm duyệt và công khai với học viên.</p></div>}else{<article class="detail-panel"><span class="badge text-bg-secondary">@(Model.Status==ProfileStatus.Approved?"Đã duyệt":Model.Status==ProfileStatus.Rejected?"Bị từ chối":"Chờ duyệt")</span><h2>@Model.User.FullName</h2><img class="avatar" src="@Url.Action("Photo",new{id=Model.Id})" alt="Ảnh đại diện"/><p class="prewrap">@Model.Introduction</p><p>@string.Join(" · ",Model.Subjects.Select(s=>s.Subject.Name))</p><p>@Model.HourlyRate.ToString("N0") đ / giờ · @Model.ExperienceYears năm kinh nghiệm</p>@if(Model.RejectionReason!=null){<div class="alert alert-warning">Lý do từ chối: @Model.RejectionReason</div>}<a asp-action="Certificate" asp-route-id="@Model.Id">Tải chứng chỉ của tôi</a>@if(Model.Status==ProfileStatus.Approved){<p><a asp-action="Details" asp-route-id="@Model.Id">Xem trang công khai</a></p>}</article>}
<a class="btn btn-primary" asp-action="Edit">@(Model==null?"Tạo hồ sơ":"Chỉnh sửa và gửi duyệt lại")</a></section>