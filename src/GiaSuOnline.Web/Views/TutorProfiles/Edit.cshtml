@model ProfileForm
@{ViewData["Title"]="Hoàn thiện hồ sơ";}
<section class="profile-editor"><p class="eyebrow">HỒ SƠ CHUYÊN MÔN</p><h1>Giới thiệu bạn với học viên</h1><p>Mỗi lần lưu, hồ sơ được chuyển về chờ kiểm duyệt.</p><form method="post" enctype="multipart/form-data" data-stepper><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Revision" type="hidden"/>
<ol class="steps"><li>1. Chuyên môn</li><li>2. Ảnh & chứng chỉ</li><li>3. Xác nhận</li></ol>
<fieldset data-step><legend>Chuyên môn và kinh nghiệm</legend><label asp-for="Introduction"></label><textarea asp-for="Introduction" class="form-control" rows="5" required minlength="20" maxlength="3000"></textarea><label asp-for="HourlyRate"></label><input asp-for="HourlyRate" class="form-control" type="number" min="1" max="100000000" step="1" required/><label asp-for="ExperienceYears"></label><input asp-for="ExperienceYears" class="form-control" min="0" max="70" required/><label asp-for="SubjectIds"></label><select asp-for="SubjectIds" asp-items="Model.SubjectOptions" class="form-select" multiple required></select><p>Giữ Ctrl (Windows) hoặc Command (Mac) để chọn nhiều môn.</p></fieldset>
<fieldset data-step><legend>Ảnh và chứng chỉ</legend><label asp-for="Photo"></label><input asp-for="Photo" class="form-control" type="file" accept=".jpg,.jpeg,.png" data-photo required="@(!Model.HasPhoto)"/><img id="photo-preview" class="preview" hidden alt="Ảnh đại diện xem trước"/><label asp-for="Certificate"></label><input asp-for="Certificate" class="form-control" type="file" accept=".jpg,.jpeg,.png,.pdf" required="@(!Model.HasCertificate)"/><p>Tệp hiện có được giữ nguyên nếu bạn không chọn tệp mới. Chứng chỉ chỉ chủ hồ sơ và quản trị viên được tải.</p></fieldset>
<fieldset data-step><legend>Gửi hồ sơ để kiểm duyệt</legend><p>Kiểm tra thông tin ở các bước trước. Sau khi gửi, quản trị viên sẽ xem xét trước khi công khai hồ sơ.</p><p id="profile-summary"></p></fieldset>
<div class="actions"><button class="btn btn-outline-secondary" type="button" data-prev hidden>Quay lại</button><button class="btn btn-outline-primary" type="button" data-next hidden>Tiếp tục</button><button class="btn btn-primary" type="submit" data-save>Lưu và gửi duyệt</button></div></form></section>