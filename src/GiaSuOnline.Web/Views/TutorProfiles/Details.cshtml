@model TutorDetail
@{ViewData["Title"]=Model.Profile.User.FullName; var p=Model.Profile;}
<section class="detail-panel"><span class="badge text-bg-success">Hồ sơ đã kiểm duyệt</span><div class="profile-heading"><img class="avatar" src="@Url.Action("Photo",new{id=p.Id})" alt="Ảnh gia sư @p.User.FullName"/><div><h1>@p.User.FullName</h1><p>@string.Join(" · ",p.Subjects.Select(x=>x.Subject.Name))</p><p>@p.ExperienceYears năm kinh nghiệm</p><h2>@p.HourlyRate.ToString("N0") đ / giờ</h2></div></div><h2>Đôi nét về gia sư</h2><p class="prewrap">@p.Introduction</p><a class="btn btn-primary" asp-action="Booking" asp-route-id="@p.Id">Đặt lịch</a></section>
<div class="two-columns"><section class="detail-panel"><h2>Đánh giá gần đây</h2>@if(Model.Reviews.Count==0){<p>Chưa có đánh giá.</p>}else{@foreach(var review in Model.Reviews){<article><strong>@review.Stars / 5 sao</strong><p>@review.Comment</p></article>}}</section><section class="detail-panel"><h2>Lịch rảnh 7 ngày tới</h2>@if(Model.Slots.Count==0){<p>Gia sư chưa công bố khung giờ rảnh.</p>}else{@foreach(var slot in Model.Slots){<p>@slot.StartsAtUtc.AddHours(7).ToString("dd/MM HH:mm") – @slot.EndsAtUtc.AddHours(7).ToString("HH:mm") (UTC+7)</p>}}</section></div>