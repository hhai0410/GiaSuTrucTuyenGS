@model SearchResults
@{ViewData["Title"]="Tìm gia sư";var f=Model.Filter;string PageUrl(int page)=>Url.Action("Index",new{f.Q,f.SubjectId,f.MinPrice,f.MaxPrice,f.MinRating,f.Language,f.Sort,page})!;}
<p class="eyebrow">TÌM NGƯỜI ĐỒNG HÀNH</p><h1>Gia sư phù hợp với bạn</h1><p>Chỉ những hồ sơ đã được kiểm duyệt xuất hiện tại đây.</p>
<div class="search-layout"><aside class="detail-panel"><h2>Bộ lọc</h2><form method="get" data-search-form><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<label for="query">Tên gia sư hoặc môn học</label><input id="query" name="Q" value="@f.Q" maxlength="100" class="form-control" list="suggestions" autocomplete="off" data-suggest-url="@Url.Action("Suggestions")"/><datalist id="suggestions"></datalist>
<label for="subject">Môn học</label><select id="subject" name="SubjectId" class="form-select"><option value="">Tất cả môn</option>@foreach(var item in Model.Subjects){<option value="@item.Value" selected="@(item.Value==f.SubjectId?.ToString())">@item.Text</option>}</select>
<label for="min">Học phí từ (đ/giờ)</label><input id="min" name="MinPrice" value="@f.MinPrice" class="form-control" type="number" min="0" max="100000000"/>
<label for="max">Học phí đến (đ/giờ)</label><input id="max" name="MaxPrice" value="@f.MaxPrice" class="form-control" type="number" min="0" max="100000000"/>
<label for="rating">Đánh giá tối thiểu</label><select id="rating" name="MinRating" class="form-select"><option value="">Không giới hạn</option>@foreach(var n in new[]{3,4,5}){<option value="@n" selected="@(f.MinRating==n)">@n sao trở lên</option>}</select>
<label for="language">Ngôn ngữ</label><select id="language" name="Language" class="form-select"><option value="">Tất cả</option>@foreach(var code in new[]{"vi","en","fr","ja","ko","zh"}){<option value="@code" selected="@(f.Language==code)">@VietnamTime.Language(code)</option>}</select>
<label for="sort">Sắp xếp</label><select id="sort" name="Sort" class="form-select"><option value="rating" selected="@(f.Sort=="rating")">Đánh giá cao nhất</option><option value="price" selected="@(f.Sort=="price")">Giá tăng dần</option><option value="price_desc" selected="@(f.Sort=="price_desc")">Giá giảm dần</option></select>
<div class="actions"><button class="btn btn-primary">Tìm gia sư</button><a asp-action="Index">Xóa bộ lọc</a></div><p data-loading hidden role="status">Đang tìm gia sư…</p></form></aside>
<section aria-label="Kết quả tìm kiếm"><div class="section-heading"><h2>@Model.Total gia sư</h2>@if(Model.Total>0){<span>Trang @f.Page / @Model.Pages</span>}</div>
@if(Model.Items.Count==0){<div class="empty"><h3>Chưa tìm thấy gia sư phù hợp</h3><p>Thử thay đổi môn học, mức giá hoặc ngôn ngữ.</p></div>}
<div class="cards search-cards">@foreach(var tutor in Model.Items){<article class="card tutor-card" data-tutor-id="@tutor.Id">@if(tutor.HasPhoto){<img src="@Url.Action("Photo","TutorProfiles",new{id=tutor.Id})" alt="Ảnh gia sư @tutor.Name"/>}else{<div class="avatar-placeholder" aria-label="Chưa có ảnh">GS</div>}<div class="card-body"><span class="badge text-bg-success">Đã kiểm duyệt</span><h3>@tutor.Name</h3><p>@string.Join(" · ",tutor.Subjects)</p><p>@VietnamTime.Language(tutor.Language) · @tutor.Experience năm kinh nghiệm</p><p>@(tutor.Rating.HasValue ? $"{tutor.Rating:0.0}/5 ({tutor.ReviewCount} đánh giá)" : "Chưa có đánh giá")</p><strong>@tutor.Rate.ToString("N0") đ / giờ</strong><a class="btn btn-outline-primary" asp-controller="TutorProfiles" asp-action="Details" asp-route-id="@tutor.Id">Xem hồ sơ</a></div></article>}</div>
<nav class="actions" aria-label="Phân trang">@if(f.Page>1){<a class="btn btn-outline-secondary" href="@PageUrl(f.Page-1)">Trang trước</a>}@if(f.Page<Model.Pages){<a class="btn btn-outline-primary" href="@PageUrl(f.Page+1)">Trang tiếp</a>}</nav></section></div>
@section Scripts{<script src="~/js/search.js" asp-append-version="true" defer nonce="@Context.Items["CspNonce"]"></script>}