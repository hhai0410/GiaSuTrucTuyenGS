@model TutorProfile
@{ViewData["Title"]="Xem xét hồ sơ";}
<section class="detail-panel"><p class="eyebrow">KIỂM DUYỆT</p><h1>@Model.User.FullName</h1><p>@Model.User.Email</p><img class="avatar" src="@Url.Action("Photo","TutorProfiles",new{area="",id=Model.Id})" alt="Ảnh gia sư"/><p class="prewrap">@Model.Introduction</p><p>@string.Join(" · ",Model.Subjects.Select(x=>x.Subject.Name))</p><p>@Model.HourlyRate.ToString("N0") đ / giờ · @Model.ExperienceYears năm kinh nghiệm</p><a asp-area="" asp-controller="TutorProfiles" asp-action="Certificate" asp-route-id="@Model.Id">Tải chứng chỉ để kiểm tra</a>
@if(Model.Status==ProfileStatus.Pending){<form asp-action="Moderate" method="post"><input type="hidden" name="Id" value="@Model.Id"/><input type="hidden" name="Revision" value="@Model.Revision"/><label for="Reason">Lý do (bắt buộc khi từ chối)</label><textarea id="Reason" name="Reason" class="form-control" maxlength="1000" rows="3"></textarea><div class="actions"><button name="Approve" value="true" class="btn btn-success">Duyệt hồ sơ</button><button name="Approve" value="false" class="btn btn-outline-danger">Từ chối</button></div></form>}else{<p>Kết quả: @(Model.Status==ProfileStatus.Approved?"Đã duyệt":"Bị từ chối")</p><p>@Model.RejectionReason</p><form asp-action="Resend" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-outline-primary">Gửi lại email kết quả</button></form>}
</section><a asp-action="Index">Quay lại danh sách</a>