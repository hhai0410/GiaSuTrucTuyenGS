@model List<TutorProfile>
@{ViewData["Title"]="Kiểm duyệt hồ sơ";}
<p class="eyebrow">QUẢN TRỊ GS</p><h1>Kiểm duyệt hồ sơ</h1><form method="get" class="filter"><label for="status">Trạng thái</label><select id="status" name="status" class="form-select">@foreach(var s in Enum.GetValues<ProfileStatus>()){<option value="@s" selected="@(s==(ProfileStatus)ViewBag.Status)">@(s==ProfileStatus.Pending?"Chờ duyệt":s==ProfileStatus.Approved?"Đã duyệt":"Bị từ chối")</option>}</select><button class="btn btn-primary">Lọc hồ sơ</button></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Gia sư</th><th>Môn dạy</th><th>Học phí / giờ</th><th>Thao tác</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.User.FullName<br/>@p.User.Email</td><td>@string.Join(", ",p.Subjects.Select(x=>x.Subject.Name))</td><td>@p.HourlyRate.ToString("N0") đ</td><td><a asp-action="Details" asp-route-id="@p.Id">Xem hồ sơ</a></td></tr>}</tbody></table></div>@if(Model.Count==0){<p>Không có hồ sơ ở trạng thái này.</p>}